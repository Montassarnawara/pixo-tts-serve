TTS_SERVER_API_KEY=change-moi
PORT=8080
# rhubarb.exe vit dans bin/ (voir README §2.4), qui n'est jamais sur le PATH système :
# cette ligne est nécessaire, pas juste optionnelle.
RHUBARB_PATH=./bin/rhubarb.exe
# À décommenter seulement si ffmpeg n'est pas dans le PATH système :
# FFMPEG_PATH=C:\chemin\vers\ffmpeg.exe
